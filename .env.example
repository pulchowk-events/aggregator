# =============================================================================
# Pulchowk Events Aggregator — environment template
# =============================================================================
# Copy to .env and fill in the blanks. Every var here is read by
# src/config/env.js and validated at startup — a missing required value
# produces a named warning, never a silent undefined.
#
# Values without a default on the right are REQUIRED for the bot to fully
# function. Lines beginning with "#" are OPTIONAL and show their defaults.

# ---------- Discord ----------
DISCORD_TOKEN=
HOME_GUILD_ID=
LOGS_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=

# Optional: dedicated channel + ping role for source-failure alerts
# (see src/scrapers/alerts.js). Falls back to audit-log only if unset.
# ALERTS_CHANNEL_ID=
# ALERTS_PING_ROLE_ID=

# ---------- Category channels (live / test) ----------
# Every category has two channels: LIVE = public, TEST = human review.
SPORTS_CHANNEL_ID=
TEST_SPORTS_CHANNEL_ID=
SOFTWARE_CHANNEL_ID=
TEST_SOFTWARE_CHANNEL_ID=
HARDWARE_CHANNEL_ID=
TEST_HARDWARE_CHANNEL_ID=
GAMING_CHANNEL_ID=
TEST_GAMING_CHANNEL_ID=
MUSIC_CHANNEL_ID=
TEST_MUSIC_CHANNEL_ID=
BUSINESS_CHANNEL_ID=
TEST_BUSINESS_CHANNEL_ID=
MISC_CHANNEL_ID=
TEST_MISC_CHANNEL_ID=
JOBS_CHANNEL_ID=
TEST_JOBS_CHANNEL_ID=
SCHOLARSHIPS_CHANNEL_ID=
TEST_SCHOLARSHIPS_CHANNEL_ID=

# Optional: role IDs pinged on live job / scholarship posts. The other 7
# category ping roles are hardcoded in src/config/roles.js — edit them there
# when forking to a different Discord server.
# JOBS_PING_ROLE_ID=
# SCHOLARSHIPS_PING_ROLE_ID=

# ---------- Web dashboard ----------
WEB_PORT=3001
# Optional but strongly recommended in production. Without them the
# dashboard's mutating /api/* routes are unauthenticated and CORS is open.
# DASHBOARD_API_KEY=
# DASHBOARD_ALLOWED_ORIGINS=

# ---------- Browser (Windows deployments) ----------
# Point these at a real installed browser + user profile so scrapers that
# need a warm session (Cloudflare, logged-in sites) launch from a real
# profile instead of the bundled Chromium.
#
# IMPORTANT: only takes effect when Node runs on Windows. Under WSL2 or
# native Linux the fs.existsSync check fails (Windows path can't be
# resolved from Linux) and the bot falls back to bundled Chromium — this is
# the correct fail-soft behaviour, not a bug.
#
# BROWSER_EXECUTABLE_PATH=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
# BROWSER_USER_DATA_DIR=C:/Users/<your-user>/AppData/Local/BraveSoftware/Brave-Browser/User Data/Profile <N>

# Optional: separate browser config for job scrapers. Falls back to the
# general BROWSER_* above if unset.
# JOB_BROWSER_EXECUTABLE_PATH=
# JOB_BROWSER_USER_DATA_DIR=

# ---------- Scrape scheduling ----------
# 5-field cron. Default every 6 hours. Overridable at runtime via
# /settings set-schedule. The active value lives in cache.settings.scrapeCron
# once set, so this env var is the FALLBACK only.
# SCRAPE_CRON=0 */6 * * *

# ---------- Autopost defaults ----------
# All overridable at runtime via /settings and /autopost.
# AUTOPOST_MIN_LEAD_DAYS=3
# NEEDS_ATTENTION_EXPIRY_DAYS=14
# MARKER_RETENTION_DAYS=180
# CACHE_SAVE_DEBOUNCE_MS=2000

# ---------- Bot archival Supabase ----------
# Service-role key. Full posted-item records. Jobs share the events table
# via a `type` column; scholarships get their own table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EVENTS_TABLE=events
# SUPABASE_SCHOLARSHIPS_TABLE=scholarships
# SUPABASE_AUTOSYNC_INTERVAL_MINUTES=60
# SUPABASE_UPSERT_BATCH_SIZE=500

# ---------- Website Supabase sync ----------
# Public-site Supabase. Service-role key. A curated subset of events + jobs
# is synced here on every scrape + hourly cron.
WEBSITE_SUPABASE_URL=
WEBSITE_SUPABASE_SERVICE_ROLE_KEY=
# WEBSITE_SYNC_ENABLED=true
# WEBSITE_SYNC_DRY_RUN=false
# WEBSITE_EVENTS_TABLE=events
# WEBSITE_JOBS_TABLE=jobs
# WEBSITE_JOBS_SYNC_ENABLED=true
# WEBSITE_SYNC_BATCH_SIZE=50
# WEBSITE_SYNC_BATCH_DELAY_MS=200
# WEBSITE_SYNC_CRON=0 * * * *

# Optional: on-demand revalidation webhook. Skipped if unset.
# WEBSITE_REVALIDATE_URL=
# WEBSITE_REVALIDATE_SECRET=

# ---------- Reserved / future ----------
# NEXTJS_SITE_URL=
# EVENTS_DUMP_CHANNEL_ID=

# ---------- CLI wizards ----------
# scripts/setup/ and scripts/wizard/ support NO_COLOR to disable ANSI escape
# codes in their interactive menus. Any non-empty value disables color.
# NO_COLOR=1
