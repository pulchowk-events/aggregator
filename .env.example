# Job/scholarship ping role IDs (optional — see src/config/roles.js).
# Every other category's ping role is hardcoded in roles.js; these two are
# read from here only if set, so existing deployments don't need to change.
# JOBS_PING_ROLE_ID=
# SCHOLARSHIPS_PING_ROLE_ID=

# Time-sensitive source-failure alerts (optional)
# Dedicated channel + ping role for "source X has failed N scrapes in a row"
# notifications. Falls back to audit-log-only if either is unset.
# ALERTS_CHANNEL_ID=
# ALERTS_PING_ROLE_ID=

# Additional Supabase config (optional — defaults shown)
# SUPABASE_SCHOLARSHIPS_TABLE=scholarships
# SUPABASE_UPSERT_BATCH_SIZE=500

# Additional Website Supabase config (optional — defaults shown)
# WEBSITE_JOBS_TABLE=jobs
# WEBSITE_JOBS_SYNC_ENABLED=true
